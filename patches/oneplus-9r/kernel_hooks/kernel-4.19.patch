diff --git a/fs/open.c b/fs/open.c
index 13d70db..c49ccba 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -453,6 +453,21 @@ long do_faccessat(int dfd, const char __user *filename, int mode)
 
 SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 {
+#ifdef CONFIG_KSU
+{
+	extern int ksu_handle_faccessat(int *dfd, struct filename **filename,
+					int *mode, int *flags);
+	struct filename *ksu_name = getname(filename);
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	if (current_uid().val >= 10000)
+		current->susfs_task_state |= BIT(24);
+#endif
+	if (!IS_ERR(ksu_name)) {
+		ksu_handle_faccessat(&dfd, &ksu_name, &mode, NULL);
+		putname(ksu_name);
+	}
+}
+#endif
 	return do_faccessat(dfd, filename, mode);
 }
 
