diff --git a/fs/exec.c b/fs/exec.c
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1900,6 +1900,13 @@
 			      struct user_arg_ptr envp,
 			      int flags)
 {
+#ifdef CONFIG_KSU
+	extern int ksu_handle_execveat(int *fd, struct filename **filename,
+				     void *argv, void *envp, int *flags);
+
+	if (!IS_ERR(filename))
+		ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
 	return __do_execve_file(fd, filename, argv, envp, flags, NULL);
 }
 
diff --git a/fs/open.c b/fs/open.c
--- a/fs/open.c
+++ b/fs/open.c
@@ -405,7 +405,29 @@
 
 	old_cred = override_creds(override_cred);
 retry:
+#ifdef CONFIG_KSU
+#ifdef CONFIG_KSU_SUSFS
+	{
+		struct filename *name = getname_flags(filename, lookup_flags, NULL);
+		extern int ksu_handle_faccessat(int *dfd, struct filename **name,
+					       int *mode, int *flags);
+
+		if (!IS_ERR(name))
+			ksu_handle_faccessat(&dfd, &name, &mode, NULL);
+		/* filename_lookup consumes name on success and failure. */
+		res = filename_lookup(dfd, name, lookup_flags, &path, NULL);
+	}
+#else
+	{
+		extern int ksu_handle_faccessat(int *dfd, const char __user **name,
+					       int *mode, int *flags);
+		ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
+		res = user_path_at(dfd, filename, lookup_flags, &path);
+	}
+#endif
+#else
 	res = user_path_at(dfd, filename, lookup_flags, &path);
+#endif
 	if (res)
 		goto out;
 
