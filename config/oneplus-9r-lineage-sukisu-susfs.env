# Diagnostic Native SUSFS v2.4 foundation: ADB-root + KPM + mount/uname/cmdline/log.
# Use the dedicated SUSFS v2.4 foundation workflow; never generic Build Kernel.
CONFIG_ENV=config/oneplus-9r-lineage-sukisu-susfs.env
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-24.0
KERNEL_CONFIG=vendor/oneplus9r_sukisu_susfs_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/9b144befdfd93b90e02c663504fb9f4b95f9faf8/clang-r596125.tar.gz
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:
KSU_VARIANT=sukisu-ultra
KSU_REF=1cfa57340590971cba7521ed536da8ebbedc5f0a
KSU_HOOK_MODE=manual
ENABLE_SUSFS=true
SUSFS_LOCAL_DIR=oneplus-9r/susfs-v2
# Required by the pinned fork's unconditional path_umount() call on 4.19.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_KSU_SUSFS=y CONFIG_KSU_SUSFS_SUS_PATH=n CONFIG_KSU_SUSFS_SUS_MOUNT=y CONFIG_KSU_SUSFS_SUS_KSTAT=n CONFIG_KSU_SUSFS_SPOOF_UNAME=y CONFIG_KSU_SUSFS_ENABLE_LOG=y CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=n CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y CONFIG_KSU_SUSFS_OPEN_REDIRECT=n CONFIG_KSU_SUSFS_SUS_MAP=n CONFIG_KSU_FEATURE_ADBROOT=y CONFIG_KSU_DEBUG=n CONFIG_KPM=y
USE_CUSTOM_ANYKERNEL3=false
ANYKERNEL3_DEVICE=lemonades
ANYKERNEL3_DEVICE_ALIAS=OnePlus9R
ANYKERNEL3_SLOT_DEVICE=1
NEED_DTBO=false
BUILD_BOOT_IMG=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
