# OnePlus 9R (lemonades) -- LineageOS SM8250 kernel (Linux 4.19, kona)
# Profile: KernelSU v0.9.5 + SUSFS v1.5.5 (root-hiding build)
#
# Run it with:  Actions -> Build OnePlus 9R (SukiSU-Ultra)
# Siblings: -kernelsu.env (v0.9.5, proven) and -bakasu.env (modern fork)
# Sibling profile: config/oneplus-9r-lineage-resukisu.env (modern fork, no SUSFS)
#
# Source tree is what LineageOS itself ships for instantnoodle(p)/kebab/
# lemonades. Device-side facts this profile encodes (from
# device/oneplus/sm8250-common BoardConfigCommon.mk @ lineage-24.0):
#   TARGET_KERNEL_CONFIG     = vendor/kona-perf_defconfig + vendor/oplus.config
#   BOARD_KERNEL_IMAGE_NAME  = Image (raw; CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y)
# The action takes a single defconfig, so the oplus.config fragment is folded
# into EXTRA_DEFCONFIG below ('not set' lines written as CONFIG_X=n).

CONFIG_ENV=config/oneplus-9r-lineage-sukisu-ultra.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-24.0
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Artifact label; also becomes CONFIG_LOCALVERSION ("-OnePlus9R").
KERNEL_NAME=OnePlus9R
ADD_LOCALVERSION_TO_FILENAME=false

# =================================================================== Clang ==
#
# This tree carries LineageOS's own LLVM plumbing (root Makefile derives
# --target from CLANG_TARGET_FLAGS), so no CLANG_TRIPLE is needed. LD=ld.lld
# is required: kona-perf enables CONFIG_LTO_CLANG and GNU ld cannot link LTO
# bitcode. The GCC prebuilts stay enabled as binutils (4.19 predates LLVM_IAS)
# and for the arm32 compat vDSO.
#
# The tree is actively maintained by LineageOS and built with modern clang,
# so use a 2025 clang rather than the r450784e that stale 4.x vendor trees
# need. If compilation still trips over warnings, try r450784e
# (master-kernel-build-2022).
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:

# =============================================================== KernelSU ===
#
# SukiSU-Ultra 'builtin': the source-integrated non-GKI tree. Its SUSFS
# glue speaks the v2 API, satisfied on 4.19 by the compat shim in
# patches/oneplus-9r/ (real: path/kstat/uname/cmdline/open_redirect
# forwarding, task umount tracking, starts_with/ends_with; inert stubs:
# sus_map, sdcard monitor, avc spoofing, sus_type/avd policy hooks).
#
# Hooks come from kernel_hooks/kernel-4.19-sukisu-ultra.patch (the same
# set as the BakaSU patch minus the newfstat/fstat64 return hooks, which
# this fork does not define). 'builtin' is a moving branch -- pin a tag
# if it breaks. Manager app: SukiSU-Ultra manager.
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# Kernel side: ShirkNeko/susfs4ksu kernel-4.19 (v1.5.9, the newest non-GKI
# susfs -- simonpunk's original branch is frozen at v1.5.5 since 2025-02).
# v1.5.9's 50_add needed 5 re-anchored hunks on this tree (4.19.306 carries
# heavy stable backports and the fs_context rework), and the 10_enable
# patch is adapted for v0.9.5 (is_zygote -> ksu_is_zygote) with its
# kernel-side calls renamed to the susfs_v159_* implementations. The v2
# entry points the modern forks expect live in fs/susfs_compat.c; v0.9.5's
# glue calls the renamed v1.5.9 implementations directly.
#
# SUSFS_LOCAL_DIR makes the action use patches/oneplus-9r/ (laid out like
# susfs4ksu's kernel_patches/) instead of cloning SUSFS_REPO.
SUSFS_LOCAL_DIR=oneplus-9r
ENABLE_SUSFS=true

# ========================================================== Extra patches ===

# 4.19 predates path_umount() (added in 5.9); without the backport KernelSU
# cannot unmount its own overlays.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===

# kona-perf_defconfig already enables OVERLAY_FS and KPROBES; the toggles
# below are idempotent. CC_WERROR=y in the defconfig plus KernelSU code plus
# a 2025 clang is a recipe for a failed build, so turn it off.
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# vendor/oplus.config, verbatim from the kernel tree (lineage-24.0), in the
# original order. OnePlus touchpanel / fingerprint / charger / UFS tweaks --
# without these the device boots but touch and fingerprint misbehave.
#
# CONFIG_KPROBES=n at the end overrides the fragment's CONFIG_KPROBES=y:
# KernelSU v0.9.5 only defines the manual-hook switch bools
# (ksu_vfs_read_hook / ksu_execveat_hook / ksu_input_hook) when kprobes is
# OFF -- with kprobes on it expects its own kprobe hooks instead, and the
# sed-inserted manual hook calls fail to link.
EXTRA_DEFCONFIG=CONFIG_AW8697_HAPTIC=y CONFIG_DRM_OPLUS_NOTIFY=y CONFIG_EXFAT_FS=y CONFIG_FRAME_WARN=4096 CONFIG_HID_BETOP_FF=y CONFIG_HL6111R=n CONFIG_IST_DOWN=y CONFIG_IST_UP=y CONFIG_KPROBES=y CONFIG_MXM_DOWN=y CONFIG_MXM_UP=y CONFIG_NLS_UTF8=y CONFIG_OEM_QMI=y CONFIG_OPLUS_CALL_MODE_SUPPORT=y CONFIG_OPLUS_CHARGER_WIRELESS_PEN=y CONFIG_OPLUS_CHECK_CHARGERID_VOLT=y CONFIG_OPLUS_CHIP_SOC_NODE=y CONFIG_OPLUS_DEVICE_IFNO=y CONFIG_OPLUS_FEATURE_OPROJECT=y CONFIG_OPLUS_FEATURE_PROJECTINFO=y CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y CONFIG_OPLUS_FINGERPRINT=y CONFIG_OPLUS_FINGERPRINT_GKI_DISABLE=y CONFIG_OPLUS_FW_UPDATE=y CONFIG_OPLUS_GPIO=y CONFIG_OPLUS_RF_CABLE_MONITOR=y CONFIG_OPLUS_SENSOR_FB_QC=y CONFIG_OPLUS_SHIP_MODE_SUPPORT=y CONFIG_OPLUS_SHORT_C_BATT_CHECK=y CONFIG_OPLUS_SHORT_HW_CHECK=y CONFIG_OPLUS_SHORT_IC_CHECK=y CONFIG_OPLUS_SHORT_USERSPACE=y CONFIG_OPLUS_SM8250_CHARGER=y CONFIG_OPLUS_SMART_CHARGER_SUPPORT=y CONFIG_OPLUS_TP_APK=y CONFIG_OPLUS_TRIKEY_HALL=y CONFIG_OPLUS_TRIKEY_MAIN=y CONFIG_PGTABLE_MAPPING=y CONFIG_PSTORE=y CONFIG_QCA_CLD_WLAN=y CONFIG_QPNP_QNOVO5=n CONFIG_REGULATOR_PM8008=y CONFIG_RMNET_PERF=y CONFIG_RMNET_SHS=y CONFIG_SIM_DETECT=y CONFIG_SMB1355_SLAVE_CHARGER=n CONFIG_SMB1390_CHARGE_PUMP_PSY=n CONFIG_SSC_INTERACTIVE=y CONFIG_TOUCHIRQ_UPDATE_QOS=y CONFIG_TOUCHPANEL_NEW_SET_IRQ_WAKE=y CONFIG_TOUCHPANEL_OPLUS=y CONFIG_TOUCHPANEL_SAMSUNG=y CONFIG_TOUCHPANEL_SYNAPTICS=y CONFIG_TOUCHSCREEN_FTS=n CONFIG_TOUCHSCREEN_ST=n CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n CONFIG_UFSFEATURE=y CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8" CONFIG_KPROBES_SANITY_TEST=n CONFIG_KPROBE_EVENTS=y CONFIG_KRETPROBES=y CONFIG_OPLUS_FINGERPRINT_GOODIX_OPTICAL=y CONFIG_OPLUS_FINGERPRINT_JIIOV_OPTICAL=y CONFIG_OPLUS_FINGERPRINT_QCOM=y CONFIG_PSTORE_842_COMPRESS=n CONFIG_PSTORE_COMPRESS=y CONFIG_PSTORE_COMPRESS_DEFAULT="deflate" CONFIG_PSTORE_CONSOLE=y CONFIG_PSTORE_DEFLATE_COMPRESS=y CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y CONFIG_PSTORE_LZ4HC_COMPRESS=n CONFIG_PSTORE_LZ4_COMPRESS=n CONFIG_PSTORE_LZO_COMPRESS=n CONFIG_PSTORE_PMSG=y CONFIG_PSTORE_RAM=y CONFIG_PSTORE_ZSTD_COMPRESS=n CONFIG_QCA_CLD_WLAN_PROFILE="qca6390" CONFIG_REED_SOLOMON_ENC8=y CONFIG_TOUCHPANEL_SAMSUNG_S6SY771=y CONFIG_TOUCHPANEL_SAMSUNG_S6SY791=y CONFIG_TOUCHPANEL_SYNAPTICS_TCM_ONCELL=y CONFIG_UFSHID=y CONFIG_UFSHID_POC=y CONFIG_UFSTW=y CONFIG_UFSTW_BOOT_ENABLED=y CONFIG_UFSTW_IGNORE_GUARANTEE_BIT=y CONFIG_KPROBES=n

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

# This tree has no dtbo.img make target (LineageOS assembles it on the device
# side from the built overlays), so only the boot image is flashed via
# AnyKernel3; the existing dtbo partition is left as-is.
NEED_DTBO=false

# Set true and provide a direct link to a bootable boot.img (same device,
# same ROM) to additionally get a repacked boot.img artifact.
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
