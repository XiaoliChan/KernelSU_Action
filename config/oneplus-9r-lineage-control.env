# Diagnostic control only. Use Build OnePlus 9R (Stock control), NOT Build Kernel.
# The dedicated workflow copies the configuration extracted from the working
# boot and pins the kernel source. It never installs KSU or applies patches.
CONFIG_ENV=config/oneplus-9r-lineage-control.env
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-24.0
KERNEL_CONFIG=vendor/oneplus9r_control_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
# Keep the reference CONFIG_LOCALVERSION="-perf"; do not set a device label here.
KERNEL_NAME=
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125
# r596125 was rebuilt in place on main-kernel. Pin the original Android
# build 15071444, not the newer build 15682573 carrying the same version.
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/9b144befdfd93b90e02c663504fb9f4b95f9faf8/clang-r596125.tar.gz
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:
KSU_VARIANT=none
KSU_HOOK_MODE=none
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=
USE_CUSTOM_ANYKERNEL3=false
ANYKERNEL3_DEVICE=lemonades
ANYKERNEL3_DEVICE_ALIAS=OnePlus9R
ANYKERNEL3_SLOT_DEVICE=1
NEED_DTBO=false
BUILD_BOOT_IMG=false
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=true
