# OnePlus 9R (lemonades) -- LineageOS SM8250 kernel (Linux 4.19, kona)
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/oneplus-9r-lineage.env
#
# Source tree is what LineageOS itself ships for instantnoodle(p)/kebab/
# lemonades. Device-side facts this profile encodes (from
# device/oneplus/sm8250-common BoardConfigCommon.mk @ lineage-24.0):
#   TARGET_KERNEL_CONFIG     = vendor/kona-perf_defconfig + vendor/oplus.config
#   BOARD_KERNEL_IMAGE_NAME  = Image (raw; CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y)
# The action takes a single defconfig, so the oplus.config fragment is folded
# into EXTRA_DEFCONFIG below ('not set' lines written as CONFIG_X=n).

CONFIG_ENV=config/oneplus-9r-lineage.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-24.0
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Artifact label; also becomes CONFIG_LOCALVERSION ("-OnePlus9R").
KERNEL_NAME=OnePlus9R
ADD_LOCALVERSION_TO_FILENAME=false

# =================================================================== Clang ==
#
# This tree carries LineageOS's own LLVM plumbing (root Makefile derives
# --target from CLANG_TARGET_FLAGS), so no CLANG_TRIPLE is needed. LD=ld.lld
# is required: kona-perf enables CONFIG_LTO_CLANG and GNU ld cannot link LTO
# bitcode. The GCC prebuilts stay enabled as binutils (4.19 predates LLVM_IAS)
# and for the arm32 compat vDSO.
#
# The tree is actively maintained by LineageOS and built with modern clang,
# so use a 2025 clang rather than the r450784e that stale 4.x vendor trees
# need. If compilation still trips over warnings, try r450784e
# (master-kernel-build-2022).
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:

# =============================================================== KernelSU ===
#
# SukiSU-Ultra 'builtin': source-integrated tree; declares the CONFIG_KSU_SUSFS
# menu itself, so the KernelSU-side 10_enable patch is skipped automatically.
# Manager: SukiSU-Ultra manager app.
#
# Known risk (verified 2026-11): 'builtin' is a moving branch whose SUSFS glue
# (added 2026-04, v2 API) calls susfs_enable_log / susfs_add_sus_path_loop /
# susfs_set_hide_sus_mnts_for_non_su_procs / susfs_add_sus_map /
# susfs_start_sdcard_monitor_fn -- none of which exist in the frozen
# kernel-4.19 susfs branch (v1.5.5). Expected failure: patching and compiling
# succeed, final vmlinux link reports "undefined reference to susfs_*".
# If that happens, switch to the known-good pairing:
#   KSU_VARIANT=kernelsu  KSU_REF=v0.9.5   (official manager, flat layout,
#   exactly what the v1.5.x susfs patches were written against)
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# 'auto' resolves 4.19 -> susfs4ksu kernel-4.19 branch (v1.5.5, frozen since
# 2025-02). Kernel-side fs/susfs.c + 50_add patch apply to any near-stock
# Qualcomm 4.19 tree. If the 50_ patch rejects, SUSFS_REPO can be pointed at
# https://github.com/ShirkNeko/susfs4ksu.git (v1.5.9, same API generation).
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# 4.19 predates path_umount() (added in 5.9); without the backport KernelSU
# cannot unmount its own overlays.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===

# kona-perf_defconfig already enables OVERLAY_FS and KPROBES; the toggles
# below are idempotent. CC_WERROR=y in the defconfig plus KernelSU code plus
# a 2025 clang is a recipe for a failed build, so turn it off.
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# vendor/oplus.config, verbatim from the kernel tree (lineage-24.0), in the
# original order. OnePlus touchpanel / fingerprint / charger / UFS tweaks --
# without these the device boots but touch and fingerprint misbehave.
EXTRA_DEFCONFIG=CONFIG_AW8697_HAPTIC=y CONFIG_DRM_OPLUS_NOTIFY=y CONFIG_EXFAT_FS=y CONFIG_FRAME_WARN=4096 CONFIG_HID_BETOP_FF=y CONFIG_HL6111R=n CONFIG_IST_DOWN=y CONFIG_IST_UP=y CONFIG_KPROBES=y CONFIG_MXM_DOWN=y CONFIG_MXM_UP=y CONFIG_NLS_UTF8=y CONFIG_OEM_QMI=y CONFIG_OPLUS_CALL_MODE_SUPPORT=y CONFIG_OPLUS_CHARGER_WIRELESS_PEN=y CONFIG_OPLUS_CHECK_CHARGERID_VOLT=y CONFIG_OPLUS_CHIP_SOC_NODE=y CONFIG_OPLUS_DEVICE_IFNO=y CONFIG_OPLUS_FEATURE_OPROJECT=y CONFIG_OPLUS_FEATURE_PROJECTINFO=y CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y CONFIG_OPLUS_FINGERPRINT=y CONFIG_OPLUS_FINGERPRINT_GKI_DISABLE=y CONFIG_OPLUS_FW_UPDATE=y CONFIG_OPLUS_GPIO=y CONFIG_OPLUS_RF_CABLE_MONITOR=y CONFIG_OPLUS_SENSOR_FB_QC=y CONFIG_OPLUS_SHIP_MODE_SUPPORT=y CONFIG_OPLUS_SHORT_C_BATT_CHECK=y CONFIG_OPLUS_SHORT_HW_CHECK=y CONFIG_OPLUS_SHORT_IC_CHECK=y CONFIG_OPLUS_SHORT_USERSPACE=y CONFIG_OPLUS_SM8250_CHARGER=y CONFIG_OPLUS_SMART_CHARGER_SUPPORT=y CONFIG_OPLUS_TP_APK=y CONFIG_OPLUS_TRIKEY_HALL=y CONFIG_OPLUS_TRIKEY_MAIN=y CONFIG_PGTABLE_MAPPING=y CONFIG_PSTORE=y CONFIG_QCA_CLD_WLAN=y CONFIG_QPNP_QNOVO5=n CONFIG_REGULATOR_PM8008=y CONFIG_RMNET_PERF=y CONFIG_RMNET_SHS=y CONFIG_SIM_DETECT=y CONFIG_SMB1355_SLAVE_CHARGER=n CONFIG_SMB1390_CHARGE_PUMP_PSY=n CONFIG_SSC_INTERACTIVE=y CONFIG_TOUCHIRQ_UPDATE_QOS=y CONFIG_TOUCHPANEL_NEW_SET_IRQ_WAKE=y CONFIG_TOUCHPANEL_OPLUS=y CONFIG_TOUCHPANEL_SAMSUNG=y CONFIG_TOUCHPANEL_SYNAPTICS=y CONFIG_TOUCHSCREEN_FTS=n CONFIG_TOUCHSCREEN_ST=n CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n CONFIG_UFSFEATURE=y CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8" CONFIG_KPROBES_SANITY_TEST=n CONFIG_KPROBE_EVENTS=y CONFIG_KRETPROBES=y CONFIG_OPLUS_FINGERPRINT_GOODIX_OPTICAL=y CONFIG_OPLUS_FINGERPRINT_JIIOV_OPTICAL=y CONFIG_OPLUS_FINGERPRINT_QCOM=y CONFIG_PSTORE_842_COMPRESS=n CONFIG_PSTORE_COMPRESS=y CONFIG_PSTORE_COMPRESS_DEFAULT="deflate" CONFIG_PSTORE_CONSOLE=y CONFIG_PSTORE_DEFLATE_COMPRESS=y CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y CONFIG_PSTORE_LZ4HC_COMPRESS=n CONFIG_PSTORE_LZ4_COMPRESS=n CONFIG_PSTORE_LZO_COMPRESS=n CONFIG_PSTORE_PMSG=y CONFIG_PSTORE_RAM=y CONFIG_PSTORE_ZSTD_COMPRESS=n CONFIG_QCA_CLD_WLAN_PROFILE="qca6390" CONFIG_REED_SOLOMON_ENC8=y CONFIG_TOUCHPANEL_SAMSUNG_S6SY771=y CONFIG_TOUCHPANEL_SAMSUNG_S6SY791=y CONFIG_TOUCHPANEL_SYNAPTICS_TCM_ONCELL=y CONFIG_UFSHID=y CONFIG_UFSHID_POC=y CONFIG_UFSTW=y CONFIG_UFSTW_BOOT_ENABLED=y CONFIG_UFSTW_IGNORE_GUARANTEE_BIT=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

# This tree has no dtbo.img make target (LineageOS assembles it on the device
# side from the built overlays), so only the boot image is flashed via
# AnyKernel3; the existing dtbo partition is left as-is.
NEED_DTBO=false

# Set true and provide a direct link to a bootable boot.img (same device,
# same ROM) to additionally get a repacked boot.img artifact.
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
